{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM"], "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "allowJs": true, "checkJs": true, "noEmit": true,
    "strict": false, "skipLibCheck": true, "resolveJsonModule": true, "allowSyntheticDefaultImports": true
  },
  "include": ["src"]
}
